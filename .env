# RAGFlow对话助手ID —— 带KB检索（用于需要自动检索的场景）
RAGFLOW_CHAT_ID=ebbbc10878e611f18c6e072e1a46660f

# RAGFlow LLM-Only 助手ID —— 不绑定KB，纯LLM调用（避免RAGFlow Chat Assistant内部再做冗余KB检索导致超时）
# 在RAGFlow控制台创建：Chat Assistant → 配置LLM模型 → 不关联任何知识库 → 获取ID填入下方
RAGFLOW_CHAT_ID_LLM=782ebe02791d11f18b66d7a9d9327795

# RAGFlow模型名称（OpenAI兼容端点必须用完整ID）
LLM_MODEL_NAME=deepseek-v4-flash@shiki@DeepSeek
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 知识库ID（只有一个知识库，在RAGFlow控制台知识库页面获取）
